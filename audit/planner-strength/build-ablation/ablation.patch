diff --git a/test/planner-build-ablation.mjs b/test/planner-build-ablation.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..48d6e18ff0f41595d5339596afd477096a817efd
--- /dev/null
+++ b/test/planner-build-ablation.mjs
@@ -0,0 +1,120 @@
+import assert from 'node:assert/strict';
+import {appendFileSync,writeFileSync} from 'node:fs';
+import {isDeepStrictEqual} from 'node:util';
+import {isMainThread,parentPort,Worker,workerData} from 'node:worker_threads';
+import {botAction} from '../src/bot.mjs';
+import {createGame,plotCount,seedNumber,transition} from '../src/engine.mjs';
+import {checkGame,writeSave} from '../src/save.mjs';
+
+const POLICIES=['full-turn','build-sequence'];
+const STYLES=['builder','miner','council'];
+const resultStats=()=>({decisions:0,cpuUs:0,builds:0});
+
+function decide(game,policy,stats) {
+  const before=process.threadCpuUsage();
+  const action=botAction(game,policy);
+  const used=process.threadCpuUsage(before);
+  stats.cpuUs+=used.user+used.system;
+  stats.decisions++;
+  stats.builds+=Number(action.kind==='build');
+  return action;
+}
+
+function finish(game,seat,policy,opponents,stats) {
+  let steps=0;
+  while(game.phase!=='end') {
+    assert.ok(++steps<=300,`Stalled at ${game.seed}`);
+    const action=game.actor===seat?decide(game,policy,stats):botAction(game,opponents[game.actor]);
+    game=checkGame(transition(game,action));
+  }
+  return game;
+}
+
+function summarize(game,seat,stats) {
+  const vp=game.result.scores.map(score=>score.total);
+  return {...stats,vp,coins:game.result.scores.map(score=>score.coins),
+    margin:vp[seat]-Math.max(...vp.filter((_,i)=>i!==seat)),
+    win:game.result.winner===seat,shared:game.result.winner===null&&game.result.winners.includes(seat),
+    plots:plotCount(game,seat),rights:game.players[seat].held.length};
+}
+
+function opponentsAt(start,seat,panel) {
+  const n=start.playerCount;
+  const rotation=seedNumber(start.seed)%STYLES.length;
+  return Array.from({length:n},(_,i)=>{
+    if(i===seat||panel==='planner') return 'planner';
+    return STYLES[(rotation+(i-seat+n)%n-1)%STYLES.length];
+  });
+}
+
+function playPair(start,seat,panel) {
+  const stats=POLICIES.map(resultStats);
+  const opponents=opponentsAt(start,seat,panel);
+  const compared={cards:0,pending:0,tax:0,cpuUs:[0,0]};
+  let game=createGame(start);
+  let step=0;
+  while(game.phase!=='end') {
+    assert.ok(++step<=300,`Stalled at ${start.seed}`);
+    if(game.actor!==seat) {
+      game=checkGame(transition(game,botAction(game,opponents[game.actor])));
+      continue;
+    }
+    const measure=stats.map(row=>row.cpuUs);
+    const first=(step+seat)%2;
+    const choices=[];
+    for(const index of [first,1-first]) choices[index]=decide(game,POLICIES[index],stats[index]);
+    compared.cpuUs=compared.cpuUs.map((us,i)=>us+stats[i].cpuUs-measure[i]);
+    if(game.phase==='tax') compared.tax++;
+    else if(game.pending.length) compared.pending++;
+    else compared.cards++;
+
+    if(!isDeepStrictEqual(...choices)) {
+      const firstDifference={round:game.round,turn:game.turn,left:game.left,phase:game.phase,pending:game.pending,
+        choices,save:writeSave(game)};
+      const results=choices.map((action,i)=>{
+        const next=checkGame(transition(game,action));
+        return summarize(finish(next,seat,POLICIES[i],opponents,stats[i]),seat,stats[i]);
+      });
+      return {seat,opponents,compared,firstDifference,results};
+    }
+    game=checkGame(transition(game,choices[0]));
+  }
+  return {seat,opponents,compared,firstDifference:null,results:stats.map(row=>summarize(game,seat,row))};
+}
+
+if(!isMainThread) {
+  for(const {panel,start} of workerData) {
+    const seats=Array.from({length:start.playerCount},(_,seat)=>seat);
+    let rows;
+    if(panel==='control') {
+      const game=finish(createGame(start),-1,'planner',seats.map(()=> 'planner'),resultStats());
+      rows=seats.map(seat=>({seat,result:summarize(game,seat,resultStats())}));
+    } else rows=seats.map(seat=>playPair(start,seat,panel));
+    parentPort.postMessage({panel,start,rows});
+  }
+} else {
+  const [panel,countText,prefix,output]=process.argv.slice(2);
+  const count=Number(countText);
+  const jobs=Number(process.env.KUTNA_JOBS??6);
+  assert.ok(['planner','specialists','control'].includes(panel)&&Number.isInteger(count)&&count>0&&prefix&&output,
+    'node test/planner-build-ablation.mjs <planner|specialists|control> <boards-per-size> <seed-prefix> <results.jsonl>');
+  assert.ok(Number.isInteger(jobs)&&jobs>0);
+  const starts=[4,3,2].flatMap(playerCount=>Array.from({length:count},(_,i)=>({panel,start:{
+    playerCount,seed:`${prefix}-${playerCount}-${i}`,setup:i%9+1,
+    side:Math.floor(i/2)%playerCount,starter:i%playerCount,events:i%2===1,
+  }})));
+  writeFileSync(output,'');
+  const workers=Math.min(jobs,starts.length);
+  let completed=0;
+  await Promise.all(Array.from({length:workers},(_,i)=>new Promise((resolve,reject)=>{
+    const batch=starts.filter((_,j)=>j%workers===i);
+    const worker=new Worker(new URL(import.meta.url),{workerData:batch});
+    worker.on('message',row=>{
+      appendFileSync(output,JSON.stringify(row)+'\n');
+      completed++;
+      if(completed%6===0||completed===starts.length) console.error(`${completed}/${starts.length} starting boards complete`);
+    });
+    worker.once('error',reject);
+    worker.once('exit',code=>code===0?resolve():reject(Error(`Worker ${i} exited with ${code}`)));
+  })));
+}
